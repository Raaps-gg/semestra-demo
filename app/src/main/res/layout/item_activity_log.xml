<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_small"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageLogType"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/activity_log_type_content_description"
            android:src="@android:drawable/ic_menu_info_details" />

        <TextView
            android:id="@+id/textLogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/notion_text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textLogTypeTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_activity_tag"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/notion_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textLogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="24dp"
        android:textColor="@color/notion_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
