<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_content"
    app:cardBackgroundColor="@color/notion_bg"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/notion_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_content">

        <ImageView
            android:id="@+id/imageWarning"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/review_warning_content_description"
            android:src="@android:drawable/ic_dialog_alert"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#C27803"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/notion_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageWarning"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Midterm Exam" />

        <TextView
            android:id="@+id/textEventMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/notion_text_secondary"
            android:textSize="@dimen/text_caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/textEventTitle"
            app:layout_constraintTop_toBottomOf="@id/textEventTitle"
            tools:text="CS 101 · Jan 12, 2026" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEditEvent"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/edit"
            android:textColor="@color/notion_text_secondary"
            app:layout_constraintStart_toStartOf="@id/textEventTitle"
            app:layout_constraintTop_toBottomOf="@id/textEventMeta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDeleteEvent"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/delete"
            android:textColor="@color/notion_error"
            app:layout_constraintBaseline_toBaselineOf="@id/buttonEditEvent"
            app:layout_constraintStart_toEndOf="@id/buttonEditEvent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
