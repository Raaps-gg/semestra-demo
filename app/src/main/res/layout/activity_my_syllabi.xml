<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notion_surface"
    android:padding="@dimen/space_screen">

    <TextView
        android:id="@+id/textSyllabiHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/my_syllabi_hint"
        android:textColor="@color/notion_text_secondary"
        android:textSize="@dimen/text_caption"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSyllabi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSyllabiHint" />

    <TextView
        android:id="@+id/textSyllabiEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_syllabi_empty"
        android:textColor="@color/notion_text_secondary"
        android:textSize="@dimen/text_body"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerSyllabi"
        app:layout_constraintEnd_toEndOf="@id/recyclerSyllabi"
        app:layout_constraintStart_toStartOf="@id/recyclerSyllabi"
        app:layout_constraintTop_toTopOf="@id/recyclerSyllabi" />

</androidx.constraintlayout.widget.ConstraintLayout>
