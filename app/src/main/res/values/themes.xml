<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Semestra" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/notion_primary_action</item>
        <item name="colorPrimaryVariant">@color/notion_primary_action</item>
        <item name="colorOnPrimary">@color/notion_on_primary_action</item>
        <item name="colorSecondary">@color/notion_text_secondary</item>
        <item name="colorSecondaryVariant">@color/notion_text_secondary</item>
        <item name="colorOnSecondary">@color/notion_bg</item>
        <item name="colorSurface">@color/notion_bg</item>
        <item name="android:colorBackground">@color/notion_surface</item>
        <item name="android:textColorPrimary">@color/notion_text_primary</item>
        <item name="android:textColorSecondary">@color/notion_text_secondary</item>
        <item name="android:statusBarColor">@color/notion_bg</item>
        <item name="android:navigationBarColor">@color/notion_bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Semestra.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Semestra.Medium</item>
        <item name="materialButtonStyle">@style/Widget.Semestra.Button</item>
        <item name="chipStyle">@style/Widget.Semestra.Chip.Choice</item>
        <item name="textInputStyle">@style/Widget.Semestra.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="ShapeAppearance.Semestra.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Semestra.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.Semestra.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/notion_primary_action</item>
        <item name="android:textColor">@color/notion_on_primary_action</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Semestra.Chip.Choice" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg_choice</item>
        <item name="chipStrokeColor">@color/notion_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/notion_text_primary</item>
    </style>

    <style name="Widget.Semestra.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/notion_bg</item>
        <item name="boxStrokeColor">@color/notion_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="hintTextColor">@color/notion_text_secondary</item>
        <item name="errorTextColor">@color/notion_error</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>